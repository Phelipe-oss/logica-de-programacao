programa
{
	
	funcao inicio()
	{
		const inteiro MAX=100
		cadeia lista[MAX]

		inteiro i,cont


		escreva("quantos produtos vai ter na lista?(quantidade máxima =100!) :")
		leia(i)

		se(i>100 ou i<1){
			escreva("\n")
			escreva("digite uma quantidade entre 1 e 100 itens! :(")
			}

		para(cont=0;cont<=i-1;cont++){
			escreva("digite o produto ." , cont+1 , " : ")
			leia(lista[cont])
			
			
			}
		escreva("\n")
		escreva("sua lista :")
		para(cont=0;cont<=i-1;cont++){
			escreva("\n")
			escreva(lista[cont])
			}
		
	
	}
}
