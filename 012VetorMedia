programa
{
	
	funcao inicio()
	{
		real notas[4]
		real soma=0
		real media=0
		inteiro contador

		para(contador=0 ; contador<=3 ; contador++){
			
			escreva("digite a nota do aluno :")
		leia(notas[contador])
		escreva("\n")

		soma=(notas[contador]+soma)
			
			}

	media=(soma/4)
	escreva("\n")
	escreva("a média do aluno foi :",media)

	escreva("\n")

	se(media <6){
		escreva("o aluno esta reprovado!")
		}senao{
			escreva("o aluno esta na média ou acima da média!")
			}
	
		
	}
}
