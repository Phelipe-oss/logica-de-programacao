programa
{
	
	funcao inicio()
	{
		inteiro tabuada,contador
		para ( tabuada=1;tabuada<=10;tabuada++ ){
			
			escreva("tabuada de :" , tabuada)
			escreva("\n")

			para( contador=1;contador<=10;contador++ ){
				escreva(tabuada,"x",contador,"=",tabuada*contador)
				escreva("\n")
				}
			}
	}
}
