programa
{
	
	funcao inicio()
	{
		inteiro tabuada=1,contador

		enquanto(tabuada<=10){
			escreva("\n")
			escreva("tabuada de :",tabuada)
			escreva("\n")
			escreva("\n")
			contador=1 //zerando o valor do contador para a próxima tabuada
			enquanto(contador<=10){
				escreva(tabuada,"x",contador,"=",tabuada*contador)
				escreva("\n")
				contador++
				}
				tabuada++
			}

		
	}
}
